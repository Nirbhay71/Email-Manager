# Must match the Node backend's real backend/src/.env MONGO_URI exactly —
# this service reads/writes the "categories"/"emails" collections directly
# via pymongo, bypassing Mongoose entirely.
MONGO_URI=mongodb://localhost:27017/ai_email_manager
GEMINI_API_KEY=your_gemini_api_key
CHROMA_PERSIST_DIR=./chroma_data_classifier
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
GRPC_PORT=50053
GRPC_BIND_HOST=127.0.0.1
MIN_EXAMPLES_PER_CATEGORY=15
FAST_PATH_SIMILARITY=0.92
RETRIEVAL_TOP_K=8
CLASSIFIER_DEVICE=cpu

# Shared secret checked on every gRPC call — must be the exact same value as
# SERVICE_TOKEN in backend/src/.env and search_feature_demo/.env.
SERVICE_TOKEN=

# "production" once actually deployed — the server fails open (allows calls
# without SERVICE_TOKEN) while this is "development", for easier local dev.
ENVIRONMENT=development

# Gemini model id — change when Google retires the current one.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary returns 429/5xx (quotas are per model).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

# Redis queue the backend pushes classify jobs onto (must match backend REDIS_URL).
REDIS_URL=redis://localhost:6379
CLASSIFY_BATCH_SIZE=20        # jobs pulled from the queue per iteration
GEMINI_BATCH_SIZE=15          # ambiguous emails resolved per Gemini call
CLASSIFY_MAX_ATTEMPTS=5       # deliveries before an email is left for manual sorting
CLASSIFY_RETRY_IDLE_MS=300000 # how long a failed job waits before it's retried

# Gemini pacing — free tier is 5 requests/min per model; stay under it.
GEMINI_RPM=4
GEMINI_MAX_ATTEMPTS=4
GEMINI_MAX_WAIT_SECONDS=90
