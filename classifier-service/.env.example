# Must match the Node backend's real backend/src/.env MONGO_URI exactly —
# this service reads/writes the "categories"/"emails" collections directly
# via pymongo, bypassing Mongoose entirely.
MONGO_URI=mongodb://localhost:27017/ai_email_manager
GEMINI_API_KEY=your_gemini_api_key
CHROMA_PERSIST_DIR=./chroma_data_classifier
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
GRPC_PORT=50053
GRPC_BIND_HOST=127.0.0.1
MIN_EXAMPLES_PER_CATEGORY=15
FAST_PATH_SIMILARITY=0.92
RETRIEVAL_TOP_K=8
CLASSIFIER_DEVICE=cpu

# Shared secret checked on every gRPC call — must be the exact same value as
# SERVICE_TOKEN in backend/src/.env and search_feature_demo/.env.
SERVICE_TOKEN=

# "production" once actually deployed — the server fails open (allows calls
# without SERVICE_TOKEN) while this is "development", for easier local dev.
ENVIRONMENT=development
