# ==============================================================================
# Database Configuration
# ==============================================================================
# Connection string to your MongoDB instance. 
# IMPORTANT: Use the same MongoDB instance as your Node.js backend to query the existing emails.
# The Node.js backend uses MONGODB_URI in its .env file. Copy that value here.
MONGO_URI=mongodb://localhost:27017/ai_email_manager

# Optional override for the database name (defaults to parsing from MONGO_URI)
MONGO_DB_NAME=

# Local directory path for ChromaDB vector storage (no credentials needed)
CHROMA_PERSIST_DIR=./chroma_data


# ==============================================================================
# LLM (Gemini Copilot / RAG — powers the AI chat's AskQuestion RPC)
# ==============================================================================
# Get a key from https://aistudio.google.com/apikey
# Without this, AskQuestion still starts fine but every question fails with
# "Gemini API key is missing" instead of an answer.
GEMINI_API_KEY=


# ==============================================================================
# AI Models (Public Hugging Face models - No API Key Required)
# ==============================================================================
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-1.5B-instruct
EMBEDDING_MODEL_FALLBACK=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Hardware selection: "cuda", "cpu", or "auto"
DEVICE=auto


# ==============================================================================
# Service Ports / Binding
# ==============================================================================
SEARCH_GRPC_PORT=50052
SEARCH_HTTP_PORT=8001
# Keep these bound to localhost — the Node backend must run on the same
# host/private network. Do not expose these ports publicly.
GRPC_BIND_HOST=127.0.0.1
HTTP_BIND_HOST=127.0.0.1


# ==============================================================================
# Service-to-service auth
# ==============================================================================
# Shared secret the Node backend must present on every gRPC/HTTP call.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match SERVICE_TOKEN in backend/.env and python-service/.env.
# Leave empty only when ENVIRONMENT=development.
SERVICE_TOKEN=
ENVIRONMENT=development

# Origins allowed to call the HTTP API directly from a browser (rarely needed —
# this service is normally called server-to-server by the Node backend only).
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ==============================================================================
# Retrieval & Search Tuning
# ==============================================================================
BM25_TOP_K=200
VECTOR_TOP_K=200
RRF_K=60
RERANK_TOP_N=100
RERANK_BATCH_SIZE=32
FINAL_LIMIT=20


# ==============================================================================
# Cache Configuration
# ==============================================================================
CACHE_TTL_SECONDS=60
CACHE_MAX_SIZE=512


# ==============================================================================
# Stage Timeouts (Seconds) - for graceful degradation
# ==============================================================================
TIMEOUT_METADATA_S=1.0
TIMEOUT_BM25_S=2.0
TIMEOUT_VECTOR_S=2.0
TIMEOUT_FUSION_S=0.5
TIMEOUT_RERANK_S=3.0


# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
# "json" for structured logs, "console" for human-readable output
LOG_FORMAT=console
