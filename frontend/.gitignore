# ─────────────────────────────────────────────
# frontend/.gitignore
# ─────────────────────────────────────────────

# ── Dependencies ─────────────────────────────
node_modules/
package-lock.json

# ── Build output ─────────────────────────────
dist/
dist-ssr/
build/

# ── Environment variables ────────────────────
.env
.env.*
!.env.example
*.local

# ── Logs ─────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ── TypeScript ───────────────────────────────
*.tsbuildinfo

# ── Vite / build cache ───────────────────────
.vite/

# ── OS / system ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
