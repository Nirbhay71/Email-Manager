# ==============================================================================
# Server
# ==============================================================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# MongoDB
# ==============================================================================
MONGO_URI=mongodb://localhost:27017/ai_email_manager

# ==============================================================================
# Google OAuth / Gmail / Calendar
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/your-topic

# OIDC audience your Pub/Sub push subscription is configured with, and the
# service-account email that subscription pushes as. Required outside
# NODE_ENV=development — the webhook rejects all requests without these set.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=

# ==============================================================================
# Auth secrets
# ==============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never reuse a value from another service (Twilio, etc.) — must be unique and random.
JWT_ACCESS_SECRET=

# 32-byte (64 hex char) key used to encrypt stored Google OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ==============================================================================
# Twilio (SMS alerts)
# ==============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TEST_TO_NUMBER=

# ==============================================================================
# Python microservices (search / RAG)
# ==============================================================================
HYBRID_SEARCH_GRPC_HOST=localhost:50052

# Shared secret presented on every gRPC/HTTP call to the Python services.
# Must match SERVICE_TOKEN in search_feature_demo/.env and python-service/.env.
SERVICE_TOKEN=
