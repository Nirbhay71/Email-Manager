# ─────────────────────────────────────────────
# classifier-service/.gitignore
# ─────────────────────────────────────────────

# ── Virtual environments ─────────────────────
venv/
.venv/
env/
ENV/

# ── Environment & secrets ────────────────────
.env
.env.*
!.env.example
token.json
credentials.json
client_secret*.json

# ── Python cache & build ─────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# ── Generated proto stubs ────────────────────
generated/

# ── Vector stores / local DBs ────────────────
chroma_data/
chroma_data_classifier/
chroma_db/
*.db
*.sqlite3

# ── Logs ─────────────────────────────────────
logs/
*.log

# ── OS / system ──────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
