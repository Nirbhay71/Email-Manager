MONGO_URI=mongodb://localhost:27017/ai_email_manager
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=Alibaba-NLP/gte-Qwen2-1.5B-instruct
EMBEDDING_MODEL_FALLBACK=BAAI/bge-large-en-v1.5
GEMINI_API_KEY=

GRPC_PORT=50051
# Keep bound to localhost — reached only by the Node backend on the same
# host/private network. Do not expose this port publicly.
GRPC_BIND_HOST=127.0.0.1

# Shared secret the Node backend must present on every gRPC call.
# Must match SERVICE_TOKEN in backend/.env and search_feature_demo/.env.
# Leave empty only when ENVIRONMENT=development.
SERVICE_TOKEN=
ENVIRONMENT=development
