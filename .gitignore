# ─────────────────────────────────────────────
# ROOT .gitignore  –  Email-Manager monorepo
# ─────────────────────────────────────────────

# ── Node.js ──────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.npm/
**/package-lock.json

# ── Python ───────────────────────────────────
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.pyo
**/*.pyd
**/venv/
**/.venv/
**/env/
**/ENV/
**/.pytest_cache/
**/.mypy_cache/
**/*.egg-info/
**/dist-info/

# ── Vector stores / local DBs ────────────────
**/chroma_data/
**/chroma_db/
**/chroma_data_classifier/
**/*.db
**/*.sqlite3

# ── Environment & secrets ────────────────────
**/.env
**/.env.*
!**/.env.example

# Google OAuth tokens & credentials
**/token.json
**/credentials.json
**/client_secret*.json
**/service_account*.json

# ── Logs ─────────────────────────────────────
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ── OS / system files ────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── Git internals (already ignored by git itself) ──
# .git/   <-- not needed here

# ── Generated proto stubs ────────────────────
**/generated/

# ── Coverage & test artifacts ────────────────
**/coverage/
**/.nyc_output/

# ── Temp / misc project folders ──────────────
.agents/
Generate Frontend Code/
files/
search_feature_demo/
demo/calender_reminder/.env
demo/calender_reminder/token.json
demo/calender_reminder/credentials.json